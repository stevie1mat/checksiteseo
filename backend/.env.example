# ============================================
# CheckSiteAEO Backend Environment Variables
# ============================================
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control

# ============================================
# REQUIRED - Core Configuration
# ============================================

# Supabase Configuration
# Get these from your Supabase project settings: https://app.supabase.com/project/_/settings/api
SUPABASE_URL=https://your-project.supabase.co
# Use SUPABASE_SERVICE_KEY for backend operations (has elevated permissions)
# Or use SUPABASE_KEY or SUPABASE_ANON_KEY as fallback
SUPABASE_SERVICE_KEY=your-service-role-key-here
# Alternative: SUPABASE_KEY=your-key-here
# Alternative: SUPABASE_ANON_KEY=your-anon-key-here

# CORS Configuration
# Comma-separated list of allowed origins (frontend URLs)
# For production: https://yourdomain.com,https://www.yourdomain.com
# For development: http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000

# AI/LLM API Keys
# Groq is used for the free daily scan.
GROQ_API_KEY=your-groq-api-key-here
# Eden is used for additional scans and model chat.
EDEN_API_KEY=your-eden-api-key-here
EDEN_API_BASE_URL=https://api.edenai.run
EDEN_DEFAULT_MODEL=openai/gpt-4o-mini

# ============================================
# OPTIONAL - Stripe Payment Integration
# ============================================
# Get these from: https://dashboard.stripe.com/apikeys

# Stripe Secret Key (required for payment processing)
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key-here

# Stripe Webhook Secret (required for webhook verification)
# Get from: https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret-here

# Stripe Price IDs (create these in Stripe Dashboard > Products)
# Optional if you prefer backend inline fallback pricing (see TOKEN_PACK_*_USD_CENTS below).
STRIPE_PRICE_ID_TOKENS_STARTER=price_tokens_starter_placeholder
STRIPE_PRICE_ID_TOKENS_GROWTH=price_tokens_growth_placeholder
STRIPE_PRICE_ID_TOKENS_SCALE=price_tokens_scale_placeholder

# Token billing configuration
# Billing is diamond-first. Internal token values are derived automatically:
# tokens_per_scan = TOKENS_PER_DIAMOND * DIAMONDS_PER_SCAN
# tokens_per_chat = TOKENS_PER_DIAMOND * DIAMONDS_PER_CHAT
TOKENS_PER_DIAMOND=100
DIAMONDS_PER_SCAN=10
DIAMONDS_PER_CHAT=0.5
DAILY_FREE_DIAMONDS=10
# Optional legacy override if DAILY_FREE_DIAMONDS is not set.
DAILY_FREE_TOKENS=1000
MAX_SITES_PER_USER=25
# Paid packs are configured in diamonds and converted internally to tokens.
TOKEN_PACK_STARTER_DIAMONDS=100
TOKEN_PACK_GROWTH_DIAMONDS=500
TOKEN_PACK_SCALE_DIAMONDS=2000
# Fallback one-time prices used when STRIPE_PRICE_ID_TOKENS_* is not provided.
TOKEN_PACK_STARTER_USD_CENTS=1900
TOKEN_PACK_GROWTH_USD_CENTS=7900
TOKEN_PACK_SCALE_USD_CENTS=24900
ENABLE_LEGACY_PLAN_GATES=false

# ============================================
# OPTIONAL - Email Configuration
# ============================================

# Resend API Key (for transactional emails)
# Get from: https://resend.com/api-keys
RESEND_API_KEY=re_your-resend-api-key-here

# OR use Mailtrap for development/testing
MAILTRAP_HOST=sandbox.smtp.mailtrap.io
MAILTRAP_PORT=2525
MAILTRAP_USERNAME=your-mailtrap-username
MAILTRAP_PASSWORD=your-mailtrap-password

# Enable/disable email notifications
ENABLE_EMAIL_NOTIFICATIONS=true

# ============================================
# OPTIONAL - Database & Scheduler
# ============================================

# Database URL for persistent job scheduling
# If not set, scheduler runs in-memory (jobs lost on restart)
# Format: postgresql://user:password@host:port/database
# Can use your Supabase database URL
DATABASE_URL=postgresql://user:password@host:port/database

# ============================================
# OPTIONAL - Rate Limiting
# ============================================

# Enable rate limiting (prevents abuse)
# Set to "true" to enable 24-hour rate limits per site
ENABLE_RATE_LIMIT=true

# ============================================
# OPTIONAL - Development & Testing
# ============================================

# Frontend URL (used for redirects in Stripe checkout)
# Should match your frontend URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Bypass site verification in development mode
# WARNING: Only use in development!
DEV_MODE_BYPASS_VERIFICATION=false
